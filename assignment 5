import java.util.Scanner;

public class TicTacToe {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        char[][] board = new char[3][3];
        System.out.print("Enter 9 cells (X or O): ");
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                board[i][j] = in.next().charAt(0);
            }
        }
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                System.out.print(board[i][j] + (j == 2 ? "" : " "));
            }
            System.out.println();
        }
        int xCount = 0;
        int oCount = 0;
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                if (board[i][j] == 'X') {
                    xCount++;
                } else if (board[i][j] == 'O') {
                    oCount++;
                }
            }
        }
        System.out.println("X count: " + xCount);
        System.out.println("O count: " + oCount)
        boolean xHasFullRow = false;
        for (int i = 0; i < 3; i++) {
            if (board[i][0] == 'X' && board[i][1] == 'X' && board[i][2] == 'X') {
                xHasFullRow = true;
                break;
            }
        }
        
        if (xHasFullRow) {
            System.out.println("X has a full row");
        } else {
            System.out.println("No full X row");
        }
        
        in.close();
    }
}
